# ============================================================
# LK Outreach Engine — Web (Next.js on Vercel)
# Copy to .env.local for local dev.
# Set these same vars in Vercel project settings for production.
# ============================================================

# Neon PostgreSQL — same DB as the Python tools
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# WhatsApp number for audit page CTA button (E.164, digits only)
# e.g. 5511999999999 (Brazil country code 55 + DDD + number)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Admin panel secret — choose any strong password
ADMIN_SECRET=your-strong-admin-password-here

# Anthropic API key — used by the AI booking agent (/api/chat)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Your own WhatsApp number (E.164, digits only) — billing_checker.py sends
# admin alerts here when a tenant hits D+25 or D+35
LK_OWNER_PHONE=5511999999999
