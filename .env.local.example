# ============================================================
# LK Outreach Engine — Web (Next.js on Vercel)
# Copy to .env.local for local dev.
# Set these same vars in Vercel project settings for production.
# ============================================================

# Neon PostgreSQL — same DB as the Python tools
DATABASE_URL=postgresql://outreach_app:YOURPASSWORD@YOURHOST.neon.tech/neondb?sslmode=require

# WhatsApp number for audit page CTA button (E.164, digits only)
# e.g. 5511999999999 (Brazil country code 55 + DDD + number)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
